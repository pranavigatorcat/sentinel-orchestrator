# Copy this file to .env for local configuration. Never commit real credentials.
PORT=3000
# Generic OpenAI-compatible provider configuration
# LLM_API_KEY=replace-locally
# LLM_BASE_URL=https://provider.example/v1
# LLM_MODEL=provider-model-id
#
# OpenCode inference configuration (recommended if you use an OpenCode key)
# OPENCODE_API_KEY=replace-locally
# OPENCODE_ORG_ID=required-only-for-an-OpenCode-user-session-token
# LLM_MODEL=kimi-k2.5
# Leave LLM_BASE_URL unset: Sentinel uses OpenCode's compatible endpoint.
#
# OpenCode Go configuration (recommended if you have an OpenCode Go key)
# OPENCODE_GO_API_KEY=replace-locally
# LLM_MODEL=kimi-k2.7-code
# Leave LLM_BASE_URL unset: Sentinel uses OpenCode Go's compatible endpoint.
# Optional disposable SauceDemo credentials for the live target adapter.
# SAUCE_USERNAME=standard_user
# SAUCE_PASSWORD=secret_sauce
#
# Direct OpenAI configuration (optional)
# OPENAI_API_KEY=replace-locally
# OPENAI_MODEL=gpt-4.1-mini
# TARGET_URL=https://official-target.example
# TARGET_USERNAME=demo-user@example.com
# TARGET_PASSWORD=replace-locally
